+func (c *conn) verifyMigrations() error {
+	var num sql.NullInt64
+	if err := c.QueryRow(`select max(num) from migrations;`).Scan(&num); err != nil {
+		return fmt.Errorf("select max migration: %v", err)
+	}
+	expected := int64(len(migrationsForFlavor(c.flavor)))
+	if !num.Valid || num.Int64 != expected {
+		return fmt.Errorf("unexpected migration level")
+	}
+	return nil
+}
+
+func migrationsForFlavor(databaseFlavor *flavor) []migration {
+	var result []migration
+	for _, migration := range migrations {
+		if migration.flavor == nil || migration.flavor == databaseFlavor {
+			result = append(result, migration)
+		}
+	}
+	return result
+}
