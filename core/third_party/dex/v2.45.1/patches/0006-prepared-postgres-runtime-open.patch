index 707da54..2e2e4ec 100644
--- a/storage/sql/migrate_test.go
+++ b/storage/sql/migrate_test.go
@@ -46,3 +46,70 @@ func TestMigrate(t *testing.T) {
 		}
 	}
 }
+
+func TestVerifyMigrations(t *testing.T) {
+	tests := []struct {
+		name    string
+		prepare func(*testing.T, *conn)
+		wantErr bool
+	}{
+		{name: "missing migration table", wantErr: true},
+		{
+			name: "current migration level",
+			prepare: func(t *testing.T, connection *conn) {
+				t.Helper()
+				if _, err := connection.migrate(); err != nil {
+					t.Fatalf("migrate: %v", err)
+				}
+			},
+		},
+		{
+			name: "migration level behind",
+			prepare: func(t *testing.T, connection *conn) {
+				t.Helper()
+				if _, err := connection.migrate(); err != nil {
+					t.Fatalf("migrate: %v", err)
+				}
+				if _, err := connection.Exec(`delete from migrations where num = (select max(num) from migrations);`); err != nil {
+					t.Fatalf("remove migration: %v", err)
+				}
+			},
+			wantErr: true,
+		},
+		{
+			name: "migration level ahead",
+			prepare: func(t *testing.T, connection *conn) {
+				t.Helper()
+				if _, err := connection.migrate(); err != nil {
+					t.Fatalf("migrate: %v", err)
+				}
+				future := len(migrationsForFlavor(&flavorSQLite3)) + 1
+				if _, err := connection.Exec(`insert into migrations (num, at) values ($1, current_timestamp);`, future); err != nil {
+					t.Fatalf("add future migration: %v", err)
+				}
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			db, err := sql.Open("sqlite3", ":memory:")
+			if err != nil {
+				t.Fatalf("open sqlite: %v", err)
+			}
+			t.Cleanup(func() { _ = db.Close() })
+			connection := &conn{db, &flavorSQLite3, slog.New(slog.DiscardHandler), func(error) bool { return false }}
+			if test.prepare != nil {
+				test.prepare(t, connection)
+			}
+			err = connection.verifyMigrations()
+			if test.wantErr && err == nil {
+				t.Fatal("verifyMigrations() succeeded")
+			}
+			if !test.wantErr && err != nil {
+				t.Fatalf("verifyMigrations() error = %v", err)
+			}
+		})
+	}
+}
