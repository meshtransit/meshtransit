+// OpenWithPreparedSchema opens Postgres storage only when the existing schema
+// is at the exact migration level required by this build. It never performs
+// migrations and is intended for runtime processes without DDL privileges.
+func (p *Postgres) OpenWithPreparedSchema(logger *slog.Logger) (storage.Storage, error) {
+	conn, err := p.openConnection(logger)
+	if err != nil {
+		return nil, err
+	}
+	if err := conn.verifyMigrations(); err != nil {
+		return nil, fmt.Errorf(
+			"failed to verify prepared schema: %v",
+			errors.Join(err, conn.Close()),
+		)
+	}
+	return conn, nil
+}
