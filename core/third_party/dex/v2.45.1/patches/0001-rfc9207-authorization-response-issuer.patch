+func TestSendCodeResponseIncludesConfiguredIssuer(t *testing.T) {
+	tests := []struct {
+		name          string
+		responseTypes []string
+		responseMode  string
+	}{
+		{
+			name:          "code flow query",
+			responseTypes: []string{responseTypeCode},
+			responseMode:  "query",
+		},
+		{
+			name:          "hybrid flow fragment",
+			responseTypes: []string{responseTypeCode, responseTypeIDToken},
+			responseMode:  "fragment",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			httpServer, s := newTestServer(t, func(c *Config) {
+				c.Issuer += "/non-root-path"
+			})
+			defer httpServer.Close()
+
+			authReq := storage.AuthRequest{
+				ID:            "auth-request",
+				ClientID:      "client",
+				ConnectorID:   "mock",
+				RedirectURI:   "https://client.example/callback?existing=value&iss=https%3A%2F%2Fattacker.example",
+				State:         "state",
+				Nonce:         "nonce",
+				Scopes:        []string{"openid"},
+				ResponseTypes: tc.responseTypes,
+				Claims: storage.Claims{
+					UserID:   "user",
+					Username: "user",
+				},
+				Expiry: time.Now().Add(time.Minute),
+			}
+			require.NoError(t, s.storage.CreateAuthRequest(t.Context(), authReq))
+
+			rr := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodGet, "https://attacker.example/approval", nil)
+			req.Header.Set("Forwarded", "host=attacker.example;proto=https")
+			req.Header.Set("X-Forwarded-Host", "attacker.example")
+			s.sendCodeResponse(rr, req, authReq)
+
+			require.Equal(t, http.StatusSeeOther, rr.Code)
+			redirect, err := url.Parse(rr.Header().Get("Location"))
+			require.NoError(t, err)
+
+			var response url.Values
+			if tc.responseMode == "fragment" {
+				response, err = url.ParseQuery(redirect.Fragment)
+				require.NoError(t, err)
+			} else {
+				response = redirect.Query()
+				require.Equal(t, "value", response.Get("existing"))
+			}
+
+			require.Equal(t, []string{s.issuerURL.String()}, response["iss"])
+			require.Equal(t, httpServer.URL, s.issuerURL.String())
+		})
+	}
+}
