+func (s *Server) startConnectorShutdown(ctx context.Context) <-chan struct{} {
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		<-ctx.Done()
+		s.closeConnectors()
+	}()
+	return done
+}
+
+func (s *Server) closeConnectors() {
+	s.mu.Lock()
+	if s.connectorsClosed {
+		s.mu.Unlock()
+		return
+	}
+	s.connectorsClosed = true
+	connectors := s.connectors
+	s.connectors = make(map[string]Connector)
+	s.mu.Unlock()
+
+	ids := make([]string, 0, len(connectors))
+	for id := range connectors {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		closer, ok := connectors[id].Connector.(io.Closer)
+		if !ok {
+			continue
+		}
+		if err := closer.Close(); err != nil {
+			s.logger.Error("server: failed to close connector", "connector_id", id)
+		}
+	}
+}
