+type delayedConnector struct {
+	entered     chan struct{}
+	release     chan struct{}
+	releaseOnce sync.Once
+	closeCalls  int
+}
+
+func newDelayedConnector() *delayedConnector {
+	return &delayedConnector{
+		entered: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+}
+
+func (delayed *delayedConnector) Close() error {
+	delayed.closeCalls++
+	close(delayed.entered)
+	<-delayed.release
+	return nil
+}
+
+func (delayed *delayedConnector) releaseClose() {
+	delayed.releaseOnce.Do(func() { close(delayed.release) })
+}
