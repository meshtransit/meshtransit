+func TestServerDoneWaitsForConnectors(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	serverSigner, err := signer.NewMockSigner(testKey)
+	if err != nil {
+		t.Fatalf("create mock signer: %v", err)
+	}
+	server := newLifecycleTestServer(t, ctx, memory.New(newLogger(t)), serverSigner, time.Hour)
+	delayedConnector := newDelayedConnector()
+	server.mu.Lock()
+	server.connectors["mock"] = Connector{ResourceVersion: "1", Connector: delayedConnector}
+	server.mu.Unlock()
+	t.Cleanup(func() {
+		cancel()
+		delayedConnector.releaseClose()
+	})
+
+	cancel()
+	waitForChannelClose(t, delayedConnector.entered)
+	assertChannelOpen(t, server.Done())
+	delayedConnector.releaseClose()
+	waitForChannelClose(t, server.Done())
+	if delayedConnector.closeCalls != 1 {
+		t.Fatalf("connector close calls = %d, want 1", delayedConnector.closeCalls)
+	}
+}
+
