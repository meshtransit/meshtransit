{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshtransit.example/schemas/dex-patch-artifact-v1.json",
  "title": "MeshTransit Dex patch artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream",
    "patches",
    "source_tree_sha256",
    "build",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "meshtransit.dex-patch/v1"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "commit", "module_path", "module_version"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "https://github.com/dexidp/dex.git"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "module_path": {
          "type": "string",
          "const": "github.com/dexidp/dex"
        },
        "module_version": {
          "type": "string",
          "pattern": "^v0\\.0\\.0-[0-9]{14}-[0-9a-f]{12}$"
        }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "source_tree_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_version", "flags", "binary_sha256"],
      "properties": {
        "go_version": {
          "type": "string",
          "pattern": "^go1\\.[0-9]+\\.[0-9]+$"
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_inventory",
        "sbom",
        "vulnerability_report",
        "qualification_report"
      ],
      "properties": {
        "license_inventory": {
          "$ref": "#/$defs/fileReference"
        },
        "sbom": {
          "$ref": "#/$defs/fileReference"
        },
        "vulnerability_report": {
          "$ref": "#/$defs/fileReference"
        },
        "qualification_report": {
          "$ref": "#/$defs/fileReference"
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
