<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>net.meshtransit.meshnetd</string>
	<!-- The privileged helper: utun links, host routes, host DNS. Runs as root.
	     Subnet routes stay off until root turns them on:
	     sudo meshnetd routes accept on -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/meshtransit/meshnetd</string>
		<string>--allow-user=_meshd</string>
		<string>--enable-dns</string>
		<string>--enable-subnet-routes</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/meshtransit/meshnetd.log</string>
</dict>
</plist>
