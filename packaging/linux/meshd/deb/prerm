#!/bin/sh
set -e

reinstall_marker=/etc/meshd/.start-on-reinstall

case "$1" in
    remove)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            if systemctl --system is-active --quiet meshd.service; then
                umask 077
                : >"${reinstall_marker}"
            else
                rm -f -- "${reinstall_marker}"
            fi
            deb-systemd-invoke stop meshd.service meshnetd.service meshcred.service >/dev/null || true
        fi
        # The helper keeps its exit kill switch while root's settings name an
        # exit pool, also when it stops: a removed package must not leave the
        # host offline.
        if [ -z "${DPKG_ROOT:-}" ] && [ -x /usr/libexec/meshtransit/meshnetd ]; then
            /usr/libexec/meshtransit/meshnetd --release-exit >/dev/null 2>&1 || true
        fi
        ;;
esac
