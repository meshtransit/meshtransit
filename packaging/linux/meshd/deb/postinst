#!/bin/sh
set -e

reinstall_marker=/etc/meshd/.start-on-reinstall

configure_accounts_and_directories() {
    if [ -n "${DPKG_ROOT:-}" ]; then
        systemd-sysusers --root="${DPKG_ROOT}" meshd.conf
        systemd-tmpfiles --root="${DPKG_ROOT}" --create meshd.conf
    else
        systemd-sysusers meshd.conf
        systemd-tmpfiles --create meshd.conf
    fi
}

configure_unit() {
    unit="$1"
    previous_version="$2"

    deb-systemd-helper unmask "${unit}" >/dev/null || true

    # Packages before 0.1.0~alpha6 did not create deb-systemd-helper state.
    # Preserve an administrator's disabled unit when migrating those systems.
    if [ -n "${previous_version}" ] &&
        ! deb-systemd-helper debian-installed "${unit}"; then
        if [ -n "${DPKG_ROOT:-}" ]; then
            if ! systemctl --root="${DPKG_ROOT}" is-enabled "${unit}" >/dev/null 2>&1; then
                deb-systemd-helper update-state "${unit}" >/dev/null || true
                return
            fi
        elif [ -d /run/systemd/system ] &&
            ! systemctl --system is-enabled "${unit}" >/dev/null 2>&1; then
            deb-systemd-helper update-state "${unit}" >/dev/null || true
            return
        fi
    fi

    if deb-systemd-helper --quiet was-enabled "${unit}"; then
        deb-systemd-helper enable "${unit}" >/dev/null || true
    else
        deb-systemd-helper update-state "${unit}" >/dev/null || true
    fi
}

wait_for_readiness_transition() {
    unit="$1"
    expected_running="$2"
    active_state="$(systemctl --system show --property=ActiveState --value "${unit}")"

    case "${active_state}" in
        active)
            return
            ;;
        activating|deactivating|reloading|refreshing)
            # Join the existing job. Type=notify keeps this command blocked
            # until the unit reports READY=1 or its startup deadline expires.
            systemctl --system start "${unit}" >/dev/null
            ;;
        inactive|failed)
            if [ "${expected_running}" = true ]; then
                printf '%s did not return to an active state\n' "${unit}" >&2
                return 1
            fi
            ;;
        *)
            printf '%s returned unexpected ActiveState=%s\n' \
                "${unit}" "${active_state}" >&2
            return 1
            ;;
    esac
}

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        configure_accounts_and_directories
        configure_unit meshnetd.service "${2:-}"
        configure_unit meshd.service "${2:-}"

        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            remove_reinstall_marker=false
            if [ "$1" = configure ] && [ -f "${reinstall_marker}" ]; then
                action=start
                remove_reinstall_marker=true
            elif [ "$1" = configure ] && [ -n "${2:-}" ]; then
                action=try-restart
            else
                action=start
            fi
            meshnetd_expected_running=false
            meshd_expected_running=false
            if [ "${action}" = try-restart ]; then
                if systemctl --system is-active --quiet meshnetd.service; then
                    meshnetd_expected_running=true
                fi
                if systemctl --system is-active --quiet meshd.service; then
                    meshd_expected_running=true
                fi
            fi
            if [ "${action}" = try-restart ] && [ -d /run/meshd ]; then
                # meshd comes straight back: a subnet router that stops
                # now does not tell Core it is going away.
                : >/run/meshd/restart-expected 2>/dev/null || true
            fi
            deb-systemd-invoke "${action}" meshnetd.service meshd.service >/dev/null
            wait_for_readiness_transition \
                meshnetd.service "${meshnetd_expected_running}"
            wait_for_readiness_transition \
                meshd.service "${meshd_expected_running}"
            if [ "${remove_reinstall_marker}" = true ]; then
                rm -f -- "${reinstall_marker}"
            fi
        fi
        ;;
esac
