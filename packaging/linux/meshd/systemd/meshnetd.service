[Unit]
Description=MeshTransit privileged network helper
Documentation=https://github.com/meshtransit/meshtransit
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=meshd.service
PartOf=meshd.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
User=root
Group=meshd
UMask=0007
ExecStart=/usr/libexec/meshtransit/meshnetd --allow-user=meshd --enable-dns --routed-table=5267
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/meshnetd
# A subnet router turns forwarding on per interface (IPv6: host-wide);
# every other kernel tunable stays read-only.
ReadWritePaths=/proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
