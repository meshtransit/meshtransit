#!/bin/sh
set -e

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        systemd-sysusers /usr/lib/sysusers.d/meshd.conf
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/meshd.conf

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable meshnetd.service meshd.service >/dev/null
            systemctl restart meshnetd.service meshd.service
        fi
        ;;
esac
