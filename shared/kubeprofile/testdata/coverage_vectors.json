{
  "format": "meshtransit-kubeprofile-coverage/v1",
  "note": "How much of a permission set row a group's RBAC (its ceiling) allows: none, partial or full (K2h h4). Shared by meshcore (Go) and the Console (Vitest).",
  "vectors": [
    {"name": "same rule", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "list"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "list", "watch"]}], "want": "full"},
    {"name": "verbs split over two rules", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "delete"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}, {"apiGroups": [""], "resources": ["pods"], "verbs": ["delete"]}], "want": "full"},
    {"name": "one verb missing", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "delete"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}], "want": "partial"},
    {"name": "nothing in common", "row": {"apiGroups": [""], "resources": ["secrets"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}], "want": "none"},
    {"name": "other API group", "row": {"apiGroups": ["apps"], "resources": ["pods"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}], "want": "none"},
    {"name": "empty ceiling", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}, "ceiling": [], "want": "none"},
    {"name": "ceiling wildcards cover all", "row": {"apiGroups": ["apps"], "resources": ["deployments", "deployments/scale"], "verbs": ["*"]},
     "ceiling": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}], "want": "full"},
    {"name": "row verb wildcard needs the ceiling's", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["*"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "list", "watch", "create", "update", "patch", "delete", "deletecollection"]}], "want": "partial"},
    {"name": "row resource wildcard needs the ceiling's", "row": {"apiGroups": [""], "resources": ["*"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods", "services"], "verbs": ["get"]}], "want": "partial"},
    {"name": "row group wildcard needs the ceiling's", "row": {"apiGroups": ["*"], "resources": ["pods"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}], "want": "partial"},
    {"name": "pods does not cover pods/log", "row": {"apiGroups": [""], "resources": ["pods/log"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}], "want": "none"},
    {"name": "star covers subresources", "row": {"apiGroups": [""], "resources": ["pods/log", "pods/exec"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": [""], "resources": ["*"], "verbs": ["get"]}], "want": "full"},
    {"name": "star-slash-sub covers that subresource of any resource", "row": {"apiGroups": ["apps"], "resources": ["deployments/scale"], "verbs": ["update"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["*/scale"], "verbs": ["update"]}], "want": "full"},
    {"name": "star-slash-sub does not cover the resource", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["update"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["*/scale"], "verbs": ["update"]}], "want": "none"},
    {"name": "row star-slash-sub meets a named subresource", "row": {"apiGroups": ["apps"], "resources": ["*/scale"], "verbs": ["update"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments/scale"], "verbs": ["update"]}], "want": "partial"},
    {"name": "ceiling names cover the same names", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["web"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["web", "api"]}], "want": "full"},
    {"name": "ceiling names cover any name only in part", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["web"]}], "want": "partial"},
    {"name": "other names", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["db"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["web"]}], "want": "none"},
    {"name": "ceiling without names covers named rows", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["db"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"]}], "want": "full"},
    {"name": "names split over two rules", "row": {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["a", "b"]},
     "ceiling": [{"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["a"]}, {"apiGroups": ["apps"], "resources": ["deployments"], "verbs": ["get"], "resourceNames": ["b"]}], "want": "full"},
    {"name": "a row naming the empty name is nameless requests", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["list"], "resourceNames": [""]},
     "ceiling": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["list"], "resourceNames": ["", "web"]}], "want": "full"},
    {"name": "path exact", "row": {"nonResourceURLs": ["/healthz"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["/healthz", "/livez"], "verbs": ["get"]}], "want": "full"},
    {"name": "path prefix covers", "row": {"nonResourceURLs": ["/api/v1", "/api/v1/*"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["/api", "/api/*"], "verbs": ["get"]}], "want": "full"},
    {"name": "wider row prefix is partial", "row": {"nonResourceURLs": ["/api*"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["/api/*"], "verbs": ["get"]}], "want": "partial"},
    {"name": "path star covers all", "row": {"nonResourceURLs": ["/metrics", "/debug/*"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["*"], "verbs": ["get"]}], "want": "full"},
    {"name": "a ceiling path ending in two stars", "row": {"nonResourceURLs": ["/apis", "/api/v1"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["/api**"], "verbs": ["get"]}], "want": "full"},
    {"name": "a row path ending in two stars", "row": {"nonResourceURLs": ["/api**"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["/apis"], "verbs": ["get"]}], "want": "partial"},
    {"name": "path other verb", "row": {"nonResourceURLs": ["/healthz"], "verbs": ["post"]},
     "ceiling": [{"nonResourceURLs": ["/healthz"], "verbs": ["get"]}], "want": "none"},
    {"name": "a path row ignores resource rules", "row": {"nonResourceURLs": ["/healthz"], "verbs": ["get"]},
     "ceiling": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}], "want": "none"},
    {"name": "a resource row ignores path rules", "row": {"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]},
     "ceiling": [{"nonResourceURLs": ["*"], "verbs": ["*"]}], "want": "none"},
    {"name": "a row too large to check point by point", "row": {"apiGroups": ["a1","a2","a3","a4","a5","a6","a7","a8"], "resources": ["r1","r2","r3","r4","r5","r6","r7","r8"], "verbs": ["get","list","watch","create","update","patch","delete","deletecollection"], "resourceNames": ["n1","n2","n3","n4","n5","n6","n7","n8","n9"]},
     "ceiling": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}], "want": "partial"}
  ]
}
