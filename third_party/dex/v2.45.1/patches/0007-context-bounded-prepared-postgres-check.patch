+func TestCheckPreparedSchemaHonorsCanceledContext(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatalf("open sqlite: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	connection := &conn{db, &flavorSQLite3, slog.New(slog.DiscardHandler), func(error) bool { return false }}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if err := connection.CheckPreparedSchema(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("CheckPreparedSchema() error = %v, want context cancellation", err)
+	}
+}
+
+func TestCheckPreparedSchemaRevalidatesMigrationLevel(t *testing.T) {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatalf("open sqlite: %v", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	connection := &conn{db, &flavorSQLite3, slog.New(slog.DiscardHandler), func(error) bool { return false }}
+	if _, err := connection.migrate(); err != nil {
+		t.Fatalf("migrate: %v", err)
+	}
+	if err := connection.CheckPreparedSchema(t.Context()); err != nil {
+		t.Fatalf("initial CheckPreparedSchema() error = %v", err)
+	}
+	if _, err := connection.Exec(`delete from migrations where num = (select max(num) from migrations);`); err != nil {
+		t.Fatalf("remove migration: %v", err)
+	}
+	if err := connection.CheckPreparedSchema(t.Context()); err == nil {
+		t.Fatal("CheckPreparedSchema() accepted a stale migration level")
+	}
+}
