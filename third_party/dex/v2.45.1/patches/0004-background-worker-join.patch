diff --git a/server/server_lifecycle_test.go b/server/server_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/server/server_lifecycle_test.go
@@ -0,0 +1,173 @@
+package server
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	gosundheit "github.com/AppsFlyer/go-sundheit"
+
+	"github.com/dexidp/dex/server/signer"
+	"github.com/dexidp/dex/storage"
+	"github.com/dexidp/dex/storage/memory"
+)
+
+func TestServerDoneWaitsForSigner(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	baseSigner, err := signer.NewMockSigner(testKey)
+	if err != nil {
+		t.Fatalf("create mock signer: %v", err)
+	}
+	delayedSigner := newDelayedSigner(baseSigner)
+	t.Cleanup(func() {
+		cancel()
+		delayedSigner.releaseWorker()
+	})
+
+	server := newLifecycleTestServer(t, ctx, memory.New(newLogger(t)), delayedSigner, time.Hour)
+	cancel()
+	assertChannelOpen(t, server.Done())
+	delayedSigner.releaseWorker()
+	waitForChannelClose(t, server.Done())
+}
+
+func TestServerDoneWaitsForGarbageCollection(t *testing.T) {
+	t.Parallel()
+
+	ctx, cancel := context.WithCancel(t.Context())
+	baseStorage := memory.New(newLogger(t))
+	blockingStorage := newBlockingGarbageCollectionStorage(baseStorage)
+	t.Cleanup(func() {
+		cancel()
+		blockingStorage.releaseWorker()
+	})
+	serverSigner, err := signer.NewMockSigner(testKey)
+	if err != nil {
+		t.Fatalf("create mock signer: %v", err)
+	}
+
+	server := newLifecycleTestServer(t, ctx, blockingStorage, serverSigner, time.Nanosecond)
+	waitForChannelClose(t, blockingStorage.entered)
+	cancel()
+	assertChannelOpen(t, server.Done())
+	blockingStorage.releaseWorker()
+	waitForChannelClose(t, server.Done())
+}
+
+func newLifecycleTestServer(
+	t *testing.T,
+	ctx context.Context,
+	serverStorage storage.Storage,
+	serverSigner signer.Signer,
+	garbageCollectionFrequency time.Duration,
+) *Server {
+	t.Helper()
+
+	connector := storage.Connector{
+		ID:              "mock",
+		Type:            "mockCallback",
+		Name:            "Mock",
+		ResourceVersion: "1",
+	}
+	if err := serverStorage.CreateConnector(ctx, connector); err != nil {
+		t.Fatalf("create connector: %v", err)
+	}
+	server, err := newServer(ctx, Config{
+		Issuer:        "https://issuer.example/dex",
+		Storage:       serverStorage,
+		Web:           WebConfig{Dir: "../web"},
+		Logger:        newLogger(t),
+		Signer:        serverSigner,
+		HealthChecker: gosundheit.New(),
+		GCFrequency:   garbageCollectionFrequency,
+	})
+	if err != nil {
+		t.Fatalf("create server: %v", err)
+	}
+	if server.Done() == nil {
+		t.Fatal("Done() returned nil")
+	}
+	return server
+}
+
+func assertChannelOpen(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+
+	select {
+	case <-done:
+		t.Fatal("channel closed before owned worker exited")
+	default:
+	}
+}
+
+func waitForChannelClose(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatalf("wait for worker join: %v", ctx.Err())
+	}
+}
+
+type delayedSigner struct {
+	signer.Signer
+	done        chan struct{}
+	release     chan struct{}
+	releaseOnce sync.Once
+}
+
+func newDelayedSigner(base signer.Signer) *delayedSigner {
+	return &delayedSigner{
+		Signer:  base,
+		done:    make(chan struct{}),
+		release: make(chan struct{}),
+	}
+}
+
+func (delayed *delayedSigner) Start(ctx context.Context) <-chan struct{} {
+	go func() {
+		defer close(delayed.done)
+		<-ctx.Done()
+		<-delayed.release
+	}()
+	return delayed.done
+}
+
+func (delayed *delayedSigner) releaseWorker() {
+	delayed.releaseOnce.Do(func() { close(delayed.release) })
+}
+
+type blockingGarbageCollectionStorage struct {
+	storage.Storage
+	entered     chan struct{}
+	release     chan struct{}
+	enteredOnce sync.Once
+	releaseOnce sync.Once
+}
+
+func newBlockingGarbageCollectionStorage(base storage.Storage) *blockingGarbageCollectionStorage {
+	return &blockingGarbageCollectionStorage{
+		Storage: base,
+		entered: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+}
+
+func (blocking *blockingGarbageCollectionStorage) GarbageCollect(
+	context.Context,
+	time.Time,
+) (storage.GCResult, error) {
+	blocking.enteredOnce.Do(func() { close(blocking.entered) })
+	<-blocking.release
+	return storage.GCResult{}, nil
+}
+
+func (blocking *blockingGarbageCollectionStorage) releaseWorker() {
+	blocking.releaseOnce.Do(func() { close(blocking.release) })
+}
