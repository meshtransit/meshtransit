+func TestOpenWithHTTPClientUsesInjectedClient(t *testing.T) {
+	const issuer = "https://issuer.example"
+	var requestedURL string
+	client := &http.Client{Transport: roundTripFunc(func(request *http.Request) (*http.Response, error) {
+		requestedURL = request.URL.String()
+		discovery := `{
+			"issuer":"https://issuer.example",
+			"authorization_endpoint":"https://issuer.example/authorize",
+			"token_endpoint":"https://issuer.example/token",
+			"jwks_uri":"https://issuer.example/keys",
+			"id_token_signing_alg_values_supported":["RS256"],
+			"code_challenge_methods_supported":["S256"]
+		}`
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     http.Header{"Content-Type": []string{"application/json"}},
+			Body:       io.NopCloser(strings.NewReader(discovery)),
+			Request:    request,
+		}, nil
+	})}
+	config := &Config{
+		Issuer: issuer, ClientID: "client", ClientSecret: "secret",
+		RedirectURI: issuer + "/callback", PKCEChallenge: codeChallengeMethodS256,
+	}
+
+	opened, err := config.OpenWithHTTPClient("test", slog.New(slog.DiscardHandler), client)
+	if err != nil {
+		t.Fatalf("OpenWithHTTPClient() error = %v", err)
+	}
+	closer, ok := opened.(io.Closer)
+	if !ok {
+		t.Fatal("OpenWithHTTPClient() connector does not implement io.Closer")
+	}
+	t.Cleanup(func() { _ = closer.Close() })
+	if expected := issuer + "/.well-known/openid-configuration"; requestedURL != expected {
+		t.Fatalf("discovery URL = %q, want %q", requestedURL, expected)
+	}
+}
+
+func TestOpenWithHTTPClientRejectsNilClient(t *testing.T) {
+	config := &Config{Issuer: "https://issuer.example"}
+	if _, err := config.OpenWithHTTPClient("test", slog.New(slog.DiscardHandler), nil); err == nil {
+		t.Fatal("OpenWithHTTPClient() accepted a nil client")
+	}
+}
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (roundTrip roundTripFunc) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
