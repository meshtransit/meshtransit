+// OpenWithHTTPClient opens the connector with a caller-owned client. The
+// caller controls transport policy and remains responsible for its lifecycle.
+func (c *Config) OpenWithHTTPClient(
+	id string,
+	logger *slog.Logger,
+	httpClient *http.Client,
+) (connector.Connector, error) {
+	if httpClient == nil {
+		return nil, errors.New("oidc: http client is nil")
+	}
+	if len(c.HostedDomains) > 0 {
+		return nil, fmt.Errorf("support for the Hosted domains option had been deprecated and removed, consider switching to the Google connector")
+	}
+	return c.openWithHTTPClient(id, logger, httpClient)
+}
