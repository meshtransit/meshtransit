+func TestRefreshPreservesAuthenticationTimeAcrossRotations(t *testing.T) {
+	now := time.Date(2025, time.January, 2, 4, 5, 6, 0, time.UTC)
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.RefreshTokenPolicy = &RefreshTokenPolicy{rotateRefreshTokens: true}
+		c.Now = func() time.Time { return now }
+	})
+	defer httpServer.Close()
+
+	authTime := now.Add(-time.Hour).Unix()
+	mockRefreshTokenTestStorage(t, s.storage, false, authTime)
+	tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: "test", Token: "bar"})
+	require.NoError(t, err)
+
+	for i := 1; i <= 3; i++ {
+		now = now.Add(time.Minute)
+		response, gotAuthTime := decodeRefreshTokenResponse(t, s, requestRefreshToken(s, tokenData))
+		require.Equal(t, authTime, gotAuthTime)
+
+		claims := verifiedTokenClaims(t, s, response.IDToken)
+		var issuedAt int64
+		require.NoError(t, json.Unmarshal(claims["iat"], &issuedAt))
+		require.Equal(t, now.Unix(), issuedAt)
+		require.NotEqual(t, gotAuthTime, issuedAt)
+
+		tokenData = response.Token
+	}
+
+	stored, err := s.storage.GetRefresh(t.Context(), "test")
+	require.NoError(t, err)
+	require.Equal(t, authTime, stored.Claims.AuthTime)
+}
+
+func TestConcurrentRefreshPreservesAuthenticationTime(t *testing.T) {
+	now := time.Date(2025, time.January, 2, 4, 5, 6, 0, time.UTC)
+	policy := &RefreshTokenPolicy{
+		rotateRefreshTokens: true,
+		reuseInterval:       time.Minute,
+		now:                 func() time.Time { return now },
+	}
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.RefreshTokenPolicy = policy
+		c.Now = func() time.Time { return now }
+	})
+	defer httpServer.Close()
+
+	authTime := now.Add(-time.Hour).Unix()
+	mockRefreshTokenTestStorage(t, s.storage, false, authTime)
+	tokenData, err := internal.Marshal(&internal.RefreshToken{RefreshId: "test", Token: "bar"})
+	require.NoError(t, err)
+
+	const requestCount = 8
+	recorders := make([]*httptest.ResponseRecorder, requestCount)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range recorders {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			recorders[i] = requestRefreshToken(s, tokenData)
+		}()
+	}
+	close(start)
+	wg.Wait()
+
+	var rotatedToken string
+	for _, rr := range recorders {
+		response, gotAuthTime := decodeRefreshTokenResponse(t, s, rr)
+		require.Equal(t, authTime, gotAuthTime)
+		if rotatedToken == "" {
+			rotatedToken = response.Token
+		}
+		require.Equal(t, rotatedToken, response.Token)
+	}
+
+	stored, err := s.storage.GetRefresh(t.Context(), "test")
+	require.NoError(t, err)
+	require.Equal(t, authTime, stored.Claims.AuthTime)
+}
