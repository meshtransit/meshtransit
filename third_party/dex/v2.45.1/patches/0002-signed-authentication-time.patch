+func verifiedTokenClaims(t *testing.T, s *Server, rawToken string) map[string]json.RawMessage {
+	t.Helper()
+
+	token, err := jose.ParseSigned(rawToken, []jose.SignatureAlgorithm{jose.RS256})
+	require.NoError(t, err)
+	require.Len(t, token.Signatures, 1)
+
+	keys, err := s.signer.ValidationKeys(t.Context())
+	require.NoError(t, err)
+	for _, key := range keys {
+		if key.KeyID != token.Signatures[0].Header.KeyID {
+			continue
+		}
+		payload, err := token.Verify(key.Key)
+		require.NoError(t, err)
+		var claims map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal(payload, &claims))
+		return claims
+	}
+	t.Fatal("token signing key was not published")
+	return nil
+}
