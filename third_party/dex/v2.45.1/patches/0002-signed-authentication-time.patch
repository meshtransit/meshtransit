+func requestRefreshToken(s *Server, tokenData string) *httptest.ResponseRecorder {
+	u := s.issuerURL
+	u.Path = path.Join(u.Path, "/token")
+	v := url.Values{}
+	v.Add("grant_type", "refresh_token")
+	v.Add("refresh_token", tokenData)
+
+	req := httptest.NewRequest(http.MethodPost, u.String(), bytes.NewBufferString(v.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.SetBasicAuth("test", "barfoo")
+
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+	return rr
+}
+
+type refreshTokenResponse struct {
+	Token   string `json:"refresh_token"`
+	IDToken string `json:"id_token"`
+}
+
+func decodeRefreshTokenResponse(t *testing.T, s *Server, rr *httptest.ResponseRecorder) (refreshTokenResponse, int64) {
+	t.Helper()
+	require.Equal(t, http.StatusOK, rr.Code, rr.Body.String())
+
+	var response refreshTokenResponse
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &response))
+	var authTime int64
+	require.NoError(t, json.Unmarshal(verifiedTokenClaims(t, s, response.IDToken)["auth_time"], &authTime))
+	return response, authTime
+}
