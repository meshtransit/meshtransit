+func TestNewIDTokenAuthenticationTime(t *testing.T) {
+	issuedAt := time.Date(2025, time.January, 2, 4, 5, 6, 0, time.UTC)
+	httpServer, s := newTestServer(t, func(c *Config) {
+		c.Now = func() time.Time { return issuedAt }
+	})
+	defer httpServer.Close()
+
+	tests := []struct {
+		name     string
+		authTime int64
+		wantErr  bool
+		want     bool
+	}{
+		{name: "valid", authTime: issuedAt.Add(-time.Hour).Unix(), want: true},
+		{name: "unknown", authTime: 0},
+		{name: "negative", authTime: -1, wantErr: true},
+		{name: "future", authTime: issuedAt.Add(time.Second).Unix(), wantErr: true},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			rawToken, _, err := s.newIDToken(
+				t.Context(),
+				"client",
+				storage.Claims{UserID: "user", AuthTime: tc.authTime},
+				[]string{scopeOpenID},
+				"nonce",
+				"access-token",
+				"code",
+				"connector",
+			)
+			if tc.wantErr {
+				require.Error(t, err)
+				require.Empty(t, rawToken)
+				return
+			}
+			require.NoError(t, err)
+			claims := verifiedTokenClaims(t, s, rawToken)
+			rawAuthTime, present := claims["auth_time"]
+			require.Equal(t, tc.want, present)
+			if present {
+				var authTime int64
+				require.NoError(t, json.Unmarshal(rawAuthTime, &authTime))
+				require.Equal(t, tc.authTime, authTime)
+			}
+		})
+	}
+
+	rawAccessToken, _, err := s.newAccessToken(
+		t.Context(),
+		"client",
+		storage.Claims{UserID: "user", AuthTime: issuedAt.Add(-time.Hour).Unix()},
+		[]string{scopeOpenID},
+		"nonce",
+		"connector",
+	)
+	require.NoError(t, err)
+	require.NotContains(t, verifiedTokenClaims(t, s, rawAccessToken), "auth_time")
+}
