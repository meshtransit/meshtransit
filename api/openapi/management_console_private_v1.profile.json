{
  "id": "console-cookie-csrf-private-v1",
  "format": "meshtransit-management-auth-profile/v1",
  "description": "Private source contract only. No documentation endpoint, listener or SSO is enabled. Completed direct TLS 1.2+, exact configured Host/HTTPS Origin, canonical origin-form request, fresh Core Session and current exact-scope RBAC are mandatory. Read-only Deployment capability, approval catalog and management-scope requests require the cookie and explicit session channel; every mutation additionally requires the current CSRF proof. Authorization custody, encoded/alternate routing, Referer fallback, CORS and provider-token grants are forbidden. The reserved server is an example, never an operator default.",
  "securitySchemes": {
    "accountSessionCookie": {
      "type": "apiKey",
      "in": "cookie",
      "name": "__Host-mt_session",
      "description": "One canonical nonzero Core mtas1 Account Session cookie. Fresh durable authentication, Deployment/recovery/generation and exclusive idle/absolute expiry checks apply. Never an IdP token, IaC credential or cached authority. Cookie issuance uses Secure, HttpOnly, SameSite=Lax, Path=/ and no Domain."
    },
    "sessionCSRF": {
      "type": "apiKey",
      "in": "header",
      "name": "X-MeshTransit-CSRF",
      "description": "One <=256-byte dedicated mtscsrf1 intent proof bound to the complete current Session bearer, exact Origin and Deployment. Require together with the cookie for mutations. Preparation lifetime is 30-120 whole seconds, shortened to exclusive Session expiry; no future issue time, expiry equality or skew grace. The proof is replayable intent transport, never an operation/Session grant."
    }
  },
  "parameters": {
    "ConsoleOrigin": {
      "name": "Origin",
      "in": "header",
      "required": true,
      "description": "One exact operator-configured HTTPS Origin, including canonical non-default port when configured. Missing/null/foreign Origin rejects; Referer, forwarded headers and normalization never replace it.",
      "schema": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256,
        "pattern": "^https://"
      }
    },
    "ConsoleSessionChannel": {
      "name": "X-MeshTransit-Session",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "const": "v1"
      }
    },
    "ConsoleSessionProof": {
      "name": "X-MeshTransit-CSRF",
      "in": "header",
      "required": true,
      "schema": {
        "$ref": "#/components/schemas/ConsoleSessionProof"
      }
    }
  },
  "schemas": {
    "ConsoleSessionProof": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^mtscsrf1\\.",
      "description": "Shape hint only. Core verifies the complete canonical envelope/MAC and exact cookie/Origin/Deployment/time binding before fresh durable Session authentication."
    },
    "ConsoleCSRFPrepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csrf_token",
        "expires_at"
      ],
      "properties": {
        "csrf_token": {
          "$ref": "#/components/schemas/ConsoleSessionProof"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ConsoleManagementScopePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "correlation_id"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_id",
            "workspace",
            "networks"
          ],
          "properties": {
            "principal_id": {
              "type": "string",
              "format": "uuid"
            },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "display_name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "networks": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "display_name",
                  "permissions"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "permissions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "device.read",
                        "network.read",
                        "policy.approve",
                        "policy.read",
                        "policy.publish",
                        "policy.validate",
                        "share.accept",
                        "share.offer",
                        "share.read",
                        "share.revoke"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "next_page_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ConsoleDeploymentCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_profile",
        "workspace_mode",
        "max_active_workspaces",
        "workspace_creation",
        "cloud_billing",
        "platform_operations",
        "capability_revision"
      ],
      "properties": {
        "deployment_profile": {
          "type": "string",
          "const": "self_hosted"
        },
        "workspace_mode": {
          "type": "string",
          "const": "single"
        },
        "max_active_workspaces": {
          "type": "integer",
          "const": 1
        },
        "workspace_creation": {
          "type": "string",
          "const": "bootstrap_only"
        },
        "cloud_billing": {
          "type": "boolean",
          "const": false
        },
        "platform_operations": {
          "type": "boolean",
          "const": false
        },
        "capability_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ConsoleDeviceInventoryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "correlation_id"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspace_id",
            "network_id",
            "inventory_revision",
            "devices"
          ],
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "network_id": {
              "type": "string",
              "format": "uuid"
            },
            "inventory_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "devices": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "hostname",
                  "state",
                  "is_ephemeral",
                  "version",
                  "created_at",
                  "updated_at",
                  "expires_at"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "hostname": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "active",
                      "expired",
                      "revoked",
                      "deleted"
                    ]
                  },
                  "is_ephemeral": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "next_page_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "prepare": {
    "post": {
      "operationId": "prepareConsoleSessionCSRF",
      "summary": "Prepare current-Session intent without issuing or renewing authority",
      "description": "Consume shared source/Session budgets and freshly authenticate the existing cookie before independent OS entropy. Return only the proof and exclusive expiry. No Set-Cookie, provider token, identity or resource grant. JSON whitespace around the literal empty object is allowed. Existing private transport/body/header/cookie/capacity/deadline bounds and zero-output pre-release failure apply.",
      "security": [
        {
          "accountSessionCookie": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/components/parameters/ConsoleOrigin"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionChannel"
        }
      ],
      "requestBody": {
        "required": true,
        "x-meshtransit-max-bytes": 4096,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "No-grant proof for the current Session. Cookie is never set, renewed or cleared.",
          "headers": {
            "Cache-Control": {
              "schema": {
                "type": "string",
                "const": "no-store"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsoleCSRFPrepared"
              }
            }
          }
        },
        "default": {
          "description": "Private pre-release failure leaves status/headers/body untouched. No public HTTP error mapper is enabled. Submission failure is uncertain delivery, never non-commit evidence, retry or response rewrite."
        }
      }
    }
  },
  "logout": {
    "post": {
      "operationId": "logoutConsoleSession",
      "summary": "Durably revoke the current Core Session",
      "description": "Require the current host-only Session cookie and a fresh proof bound to that exact cookie, Origin and Deployment. Atomically revoke only the matching active Session in the current recovery epoch, then expire only __Host-mt_session. Concurrent or completed revocation is an idempotent no-match. No provider token, upstream logout, alternate cookie, redirect or authority renewal is performed. JSON whitespace around the literal empty object is allowed.",
      "security": [
        {
          "accountSessionCookie": [],
          "sessionCSRF": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/components/parameters/ConsoleOrigin"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionChannel"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionProof"
        }
      ],
      "requestBody": {
        "required": true,
        "x-meshtransit-max-bytes": 4096,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      },
      "responses": {
        "204": {
          "description": "The current Core Session is durably ended and its browser cookie is expired. The response has no body.",
          "headers": {
            "Cache-Control": {
              "schema": {
                "type": "string",
                "const": "no-store"
              }
            },
            "Set-Cookie": {
              "description": "Exact host-only deletion for the Core Session cookie; no Domain or other cookie is changed.",
              "schema": {
                "type": "string",
                "const": "__Host-mt_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT; Max-Age=0; HttpOnly; Secure; SameSite=Lax"
              }
            }
          }
        },
        "default": {
          "description": "Private pre-release failure leaves status/headers/body untouched. Authentication failures use the existing bounded management denial without clearing or renewing cookies. Durable submission failure is uncertain delivery, never non-commit evidence or an automatic retry."
        }
      }
    }
  },
  "managementScopes": {
    "get": {
      "operationId": "listConsoleManagementScopes",
      "summary": "List current Session management scopes for Console navigation",
      "description": "Return only the login Workspace and a UUIDv7-keyset page of active Networks with current explicitly bound inventory, policy or sharing permissions. Navigation is not authorization. Every inventory read and management action rechecks its exact permission and scope. No CSRF proof, request body, Authorization credential, Session identifier or provider claim is accepted or returned.",
      "security": [
        {
          "accountSessionCookie": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/components/parameters/ConsoleOrigin"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionChannel"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        {
          "name": "page_token",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Fresh server-authoritative management-scope projection for the current Session login Workspace.",
          "headers": {
            "Cache-Control": {
              "schema": {
                "type": "string",
                "const": "no-store"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsoleManagementScopePage"
              }
            }
          }
        },
        "default": {
          "description": "Bounded generic authentication, request, rate-limit or availability failure. No Session, membership, role-binding or cross-scope evidence is disclosed."
        }
      }
    }
  },
  "deploymentCapabilities": {
    "get": {
      "operationId": "getConsoleDeploymentCapabilities",
      "summary": "Read the current server-authoritative Deployment capability projection",
      "description": "Return only the official self-hosted Deployment baseline and durable capability revision after fresh Session authentication. The projection is for Console navigation and route guards only. It grants no Workspace, platform, billing or operation authority; unknown, cloud, contradictory or stale authority fails closed.",
      "security": [
        {
          "accountSessionCookie": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/components/parameters/ConsoleOrigin"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionChannel"
        }
      ],
      "responses": {
        "200": {
          "description": "Fresh non-secret Deployment capability projection for the authenticated Console Session.",
          "headers": {
            "Cache-Control": {
              "schema": {
                "type": "string",
                "const": "no-store"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsoleDeploymentCapabilities"
              }
            }
          }
        },
        "default": {
          "description": "Bounded generic authentication, request, rate-limit, unsupported-profile or availability failure. No entitlement, installation key, Session or topology evidence is disclosed."
        }
      }
    }
  },
  "deviceInventory": {
    "get": {
      "operationId": "listConsoleDevices",
      "summary": "Read exact-Network durable Device inventory",
      "description": "Fresh Session and exact device.read Role Binding are mandatory on every page. UUIDv7 keyset pagination binds both scope IDs and inventory revision; a changed revision rejects continuation. Registration state is not online presence or packet authority. No keys, credentials, endpoints or provider claims are disclosed.",
      "security": [
        {
          "accountSessionCookie": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/components/parameters/ConsoleOrigin"
        },
        {
          "$ref": "#/components/parameters/ConsoleSessionChannel"
        },
        {
          "name": "workspace_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "network_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "page_size",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        {
          "name": "page_token",
          "in": "query",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Fresh exact-scope Device inventory.",
          "headers": {
            "Cache-Control": {
              "schema": {
                "type": "string",
                "const": "no-store"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsoleDeviceInventoryPage"
              }
            }
          }
        },
        "403": {
          "description": "Generic missing or unauthorized scope."
        },
        "409": {
          "description": "Inventory changed. Read a new first page."
        },
        "default": {
          "description": "Bounded authentication, request, budget or availability failure."
        }
      }
    }
  }
}
