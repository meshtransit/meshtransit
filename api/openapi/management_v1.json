{
  "openapi": "3.1.0",
  "info": {
    "title": "MeshTransit Management API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://control.dev.meshtransit.net"
    }
  ],
  "paths": {
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/devices/{device_id}/actions/revoke": {
      "post": {
        "operationId": "revokeDevice",
        "summary": "Terminally revoke a Device and its current key epochs",
        "security": [
          {
            "accountSessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceID"
          },
          {
            "$ref": "#/components/parameters/NetworkID"
          },
          {
            "$ref": "#/components/parameters/DeviceID"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The Device is revoked, or the identical committed action is replayed.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/DeviceETag"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeDeviceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/PreconditionFailed"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/policy/actions/publish": {
      "post": {
        "operationId": "publishPolicy",
        "summary": "Atomically publish a compiled packet-policy release",
        "security": [
          {
            "accountSessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkspaceID"
          },
          {
            "$ref": "#/components/parameters/NetworkID"
          },
          {
            "$ref": "#/components/parameters/PolicyIfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishPolicyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The compiled policy is active and its Network revision wakeup is durable.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/PolicyETag"
              },
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishPolicyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "412": {
            "$ref": "#/components/responses/PreconditionFailed"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/Timeout"
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/resources": {
      "get": {
        "operationId": "listResources",
        "summary": "List Resources in one exact Network scope",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceState"},
          {"$ref": "#/components/parameters/PageSize"},
          {"$ref": "#/components/parameters/PageToken"}
        ],
        "responses": {
          "200": {
            "description": "A deterministic UUIDv7-ordered Resource page.",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ResourceCollectionETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceListResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "post": {
        "operationId": "createResource",
        "summary": "Create a Device-backed Resource",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceIfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateResourceRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The Resource is created, or the identical committed creation is replayed.",
            "headers": {
              "Location": {"$ref": "#/components/headers/ResourceLocation"},
              "ETag": {"$ref": "#/components/headers/ResourceETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "412": {"$ref": "#/components/responses/PreconditionFailed"},
          "428": {"$ref": "#/components/responses/PreconditionRequired"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/resources/{resource_id}": {
      "get": {
        "operationId": "getResource",
        "summary": "Read one Resource from an exact Network scope",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceID"}
        ],
        "responses": {
          "200": {
            "description": "The current Resource authority snapshot.",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ResourceETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/resource-groups": {
      "get": {
        "operationId": "listResourceGroups",
        "summary": "List Resource Groups in one exact Network scope",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceState"},
          {"$ref": "#/components/parameters/PageSize"},
          {"$ref": "#/components/parameters/PageToken"}
        ],
        "responses": {
          "200": {
            "description": "A deterministic UUIDv7-ordered Resource Group page.",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ResourceGroupCollectionETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceGroupListResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "post": {
        "operationId": "createResourceGroup",
        "summary": "Create an immutable Resource Group definition",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceGroupIfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateResourceGroupRequest"}}}
        },
        "responses": {
          "201": {
            "description": "The Resource Group is created, or the identical committed creation is replayed.",
            "headers": {
              "Location": {"$ref": "#/components/headers/ResourceGroupLocation"},
              "ETag": {"$ref": "#/components/headers/ResourceGroupETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceGroupResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "412": {"$ref": "#/components/responses/PreconditionFailed"},
          "428": {"$ref": "#/components/responses/PreconditionRequired"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/networks/{network_id}/resource-groups/{resource_group_id}": {
      "get": {
        "operationId": "getResourceGroup",
        "summary": "Read one Resource Group from an exact Network scope",
        "security": [{"accountSessionBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/WorkspaceID"},
          {"$ref": "#/components/parameters/NetworkID"},
          {"$ref": "#/components/parameters/ResourceGroupID"}
        ],
        "responses": {
          "200": {
            "description": "The current Resource Group authority snapshot.",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ResourceGroupETag"},
              "X-Correlation-ID": {"$ref": "#/components/headers/CorrelationID"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceGroupResponse"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthenticated"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accountSessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque MeshTransit Account Session"
      }
    },
    "parameters": {
      "WorkspaceID": {
        "name": "workspace_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PublicID"
        }
      },
      "NetworkID": {
        "name": "network_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PublicID"
        }
      },
      "DeviceID": {
        "name": "device_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/PublicID"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "One strong quoted decimal Device version. Wildcard and weak validators are forbidden.",
        "schema": {
          "type": "string",
          "pattern": "^\\\"[1-9][0-9]*\\\"$"
        }
      },
      "PolicyIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "One strong quoted decimal active Policy revision. Wildcard and weak validators are forbidden.",
        "schema": {
          "type": "string",
          "pattern": "^\\\"[1-9][0-9]*\\\"$"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A caller-generated opaque key. Core retains only a versioned HMAC digest.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:~-]+$"
        }
      },
      "ResourceID": {
        "name": "resource_id",
        "in": "path",
        "required": true,
        "schema": {"$ref": "#/components/schemas/PublicID"}
      },
      "ResourceGroupID": {
        "name": "resource_group_id",
        "in": "path",
        "required": true,
        "schema": {"$ref": "#/components/schemas/PublicID"}
      },
      "ResourceIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "One strong quoted decimal Resource inventory revision.",
        "schema": {"type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$"}
      },
      "ResourceGroupIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "One strong quoted decimal Resource Group collection revision.",
        "schema": {"type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$"}
      },
      "ResourceState": {
        "name": "state",
        "in": "query",
        "required": false,
        "schema": {"type": "string", "enum": ["active", "suspended", "deleted"]}
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}
      },
      "PageToken": {
        "name": "page_token",
        "in": "query",
        "required": false,
        "description": "Opaque continuation token pinned to the collection revision and filter.",
        "schema": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "headers": {
      "DeviceETag": {
        "description": "The strong quoted decimal terminal Device version.",
        "schema": {
          "type": "string"
        }
      },
      "PolicyETag": {
        "description": "The strong quoted decimal active Policy revision.",
        "schema": {
          "type": "string"
        }
      },
      "ResourceETag": {
        "description": "The strong quoted decimal Resource version.",
        "schema": {"type": "string"}
      },
      "ResourceLocation": {
        "description": "The canonical exact-scope Resource path.",
        "schema": {"type": "string", "minLength": 1}
      },
      "ResourceCollectionETag": {
        "description": "The strong quoted decimal Resource inventory revision.",
        "schema": {"type": "string"}
      },
      "ResourceGroupETag": {
        "description": "The strong quoted decimal Resource Group version.",
        "schema": {"type": "string"}
      },
      "ResourceGroupLocation": {
        "description": "The canonical exact-scope Resource Group path.",
        "schema": {"type": "string", "minLength": 1}
      },
      "ResourceGroupCollectionETag": {
        "description": "The strong quoted decimal Resource Group collection revision.",
        "schema": {"type": "string"}
      },
      "CorrelationID": {
        "description": "A server-generated UUIDv7 used to correlate the safe response and operational log.",
        "schema": {
          "$ref": "#/components/schemas/PublicID"
        }
      },
      "RateLimitLimit": {
        "description": "The burst capacity for the limiter that made the decision.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "RateLimitRemaining": {
        "description": "Tokens immediately available after the decision.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimitReset": {
        "description": "Whole seconds until one request can be admitted.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "RetryAfter": {
        "description": "Whole seconds before the caller should retry.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "PublicID": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "RevokeDeviceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "RevokeDeviceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "correlation_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RevokedDevice"
          },
          "correlation_id": {
            "$ref": "#/components/schemas/PublicID"
          }
        }
      },
      "RevokedDevice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "state",
          "device_version",
          "session_generation",
          "network_revision",
          "inventory_revision"
        ],
        "properties": {
          "device_id": {
            "$ref": "#/components/schemas/PublicID"
          },
          "state": {
            "const": "revoked"
          },
          "device_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "session_generation": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "network_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "inventory_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          }
        }
      },
      "PublishPolicyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "rules"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "rules": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/CompiledPolicyRule"
            }
          }
        }
      },
      "CompiledPolicyRule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_device_id",
          "destination_device_id",
          "protocol",
          "destination_port_ranges"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PublicID"
          },
          "source_device_id": {
            "$ref": "#/components/schemas/PublicID"
          },
          "destination_device_id": {
            "$ref": "#/components/schemas/PublicID"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "icmp"
            ]
          },
          "destination_port_ranges": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/PortRange"
            }
          }
        }
      },
      "PortRange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "PublishPolicyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "correlation_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PublishedPolicy"
          },
          "correlation_id": {
            "$ref": "#/components/schemas/PublicID"
          }
        }
      },
      "PublishedPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release_id",
          "policy_revision",
          "network_revision",
          "semantic_hash",
          "rule_count"
        ],
        "properties": {
          "release_id": {
            "$ref": "#/components/schemas/PublicID"
          },
          "policy_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "network_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 2
          },
          "semantic_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "CreateResourceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "device_id", "reason"],
        "properties": {
          "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
          "device_id": {"$ref": "#/components/schemas/PublicID"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      },
      "Resource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id", "display_name", "owner_principal_id", "custodian_principal_id",
          "device_id", "kind", "state", "provenance", "version", "target_generation",
          "semantic_hash", "activated_network_revision", "inventory_revision"
        ],
        "properties": {
