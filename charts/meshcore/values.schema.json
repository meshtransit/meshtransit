{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "roles", "config", "runtimeSecret", "controlTLS", "migration"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["all", "api", "control", "worker", "relay"],
      "properties": {
        "all": { "$ref": "#/$defs/role" },
        "api": { "$ref": "#/$defs/role" },
        "control": { "$ref": "#/$defs/role" },
        "worker": { "$ref": "#/$defs/role" },
        "relay": { "$ref": "#/$defs/role" }
      },
      "additionalProperties": false
    },
    "config": { "type": "object" },
    "runtimeSecret": {
      "type": "object",
      "required": ["name", "keys"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "keys": { "type": "object" }
      }
    },
    "controlTLS": {
      "type": "object",
      "required": ["secretName", "certificateKey", "privateKeyKey"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "certificateKey": { "type": "string", "minLength": 1 },
        "privateKeyKey": { "type": "string", "minLength": 1 }
      }
    },
    "migration": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 16 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["enabled", "replicaCount", "autoscaling"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
            "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    }
  }
}
